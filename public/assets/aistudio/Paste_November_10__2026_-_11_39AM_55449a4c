@app.get("/api/tournaments")
def get_tournaments():
    return [
        {
            "title": t["title"],
            "player_count": len(t["players"]),
            "max_sets": t["max_sets"],
        }
        for t in tournaments.values()
    ]


@app.post("/api/tournament")
def create_tournament(data: CreateTournament):
    if len(data.players) < 2:
        raise HTTPException(status_code=400, detail="حداقل ۲ بازیکن نیاز است.")

    players = list(data.players)
    random.shuffle(players)

    if len(players) % 2 != 0:
        players.append(None)

    n = len(players)
    rounds = []

    for r in range(n - 1):
        round_matches = []
        for i in range(n // 2):
            p1 = players[i]
            p2 = players[n - 1 - i]
            if p1 is not None and p2 is not None:
                round_matches.append((p1, p2))
        rounds.append(round_matches)
        players = [players[0]] + [players[-1]] + players[1:-1]

    matches = []
    match_id = 0
    for r_idx, r_matches in enumerate(rounds):
        for p1, p2 in r_matches:
            matches.append(
                {
                    "id": match_id,
                    "round": r_idx + 1,
                    "player1": p1,
                    "player2": p2,
                    "sets": [],
                    "played": False,
                }
            )
            match_id += 1

    tournaments[data.title] = {
        "title": data.title,
        "players": data.players,
        "max_sets": data.max_sets,
        "matches": matches,
    }
    return calculate_standings(data.title)


@app.get("/api/tournament/{title}")
def get_tournament(title: str):
    if title not in tournaments:
        raise HTTPException(status_code=404, detail="تورنمنت یافت نشد.")
    return calculate_standings(title)


@app.post("/api/tournament/{title}/match")
def submit_match(title: str, payload: MatchUpdate):
    if title not in tournaments:
        raise HTTPException(status_code=404, detail="تورنمنت یافت نشد.")

    t = tournaments[title]
    for m in t["matches"]:
        if m["id"] == payload.match_id:
            m["sets"] = payload.sets
            m["played"] = len(payload.sets) > 0
            break

    return calculate_standings(title)


def calculate_standings(title: str):
    t = tournaments[title]
    stats = {
        p: {
            "name": p,
            "played": 0,
            "wins": 0,
            "losses": 0,
            "points": 0,
            "set_diff": 0,
            "point_diff": 0,
        }
        for p in t["players"]
    }

    for m in t["matches"]:
        if m["played"] and m["sets"]:
            p1, p2 = m["player1"], m["player2"]
            p1_set_wins = 0
            p2_set_wins = 0

            for s in m["sets"]:
                stats[p1]["point_diff"] += s["score1"] - s["score2"]
                stats[p2]["point_diff"] += s["score2"] - s["score1"]
                if s["score1"] > s["score2"]:
                    p1_set_wins += 1
                elif s["score2"] > s["score1"]:
                    p2_set_wins += 1

            stats[p1]["played"] += 1
            stats[p2]["played"] += 1

            stats[p1]["set_diff"] += p1_set_wins - p2_set_wins
            stats[p2]["set_diff"] += p2_set_wins - p1_set_wins

            if p1_set_wins > p2_set_wins:
                stats[p1]["wins"] += 1
                stats[p1]["points"] += 2
                stats[p2]["losses"] += 1
            elif p2_set_wins > p1_set_wins:
                stats[p2]["wins"] += 1
                stats[p2]["points"] += 2
                stats[p1]["losses"] += 1

    sorted_standings = sorted(
        stats.values(),
        key=lambda x: (x["points"], x["set_diff"], x["point_diff"], x["wins"]),
        reverse=True,
    )

    return {
        "title": t["title"],
        "max_sets": t["max_sets"],
        "standings": sorted_standings,
        "matches": t["matches"],
    }


